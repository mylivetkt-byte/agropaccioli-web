generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Usuario {
  id                  String    @id @default(uuid())
  nombre              String
  telefono            String    @unique
  telefonoVerificado  Boolean   @default(false)
  cedula              String?   @unique
  fotoCedulaFrontal   String?   // URL de la imagen en el servidor
  fotoCedulaTrasera   String?
  estadoVerificacion  String    @default("PENDIENTE") // PENDIENTE, APROBADO, RECHAZADO
  rol                 String    // Productor, Comprador, Transportista
  origen              String    @default("O") // O = Original, D = Demo
  
  cosechas            Cosecha[]
  perfilTransportista PerfilTransportista?
  compradorVerificado CompradorVerificado?
  contratosProductor  Contrato[] @relation("ProductorContrato")
  contratosComprador  Contrato[] @relation("CompradorContrato")
  
  progresosAcademia   AcademiaProgreso[]
  diplomasAcademia    AcademiaDiploma[]
  nivelAcademia       Int       @default(1)
  puntosAcademia      Int       @default(0)
}

model PerfilTransportista {
  id                  String   @id @default(uuid())
  usuarioId           String   @unique
  usuario             Usuario  @relation(fields: [usuarioId], references: [id])
  
  licenciaConduccion  String?  // Opcional para Veredal
  fotoLicencia        String?
  
  placaVehiculo       String?  // Opcional para vehículos muy informales (tractores, zorras)
  tipoVehiculo        String   // Furgón, Estacas, Refrigerado, Tractomula, Jeep Willys, Chiva

  capacidadToneladas  Float
  
  aseguradoraCarga    String?  // Ej: Seguros SURA, Mapfre, Previsora
  numeroPoliza        String?
  coberturaSeguro     String?  // Ej: "Pérdida Total, Volcadura, Saqueo"
  
  // ==========================================
  // SEGURIDAD ASIMÉTRICA: VEREDAL VS NACIONAL
  // ==========================================
  categoriaTransporte String   @default("NACIONAL") // "VEREDAL" o "NACIONAL"
  zonaOperacion       String?  // Ej: "Vereda La Puerta, Aquitania" (Solo para Veredal)
  recomendacionesComunidad Int @default(0) // Confianza comunitaria (Pulgares arriba)
  fotoVehiculoFrontal String?  // Foto del vehículo para reconocimiento visual
  
  vehiculos           VehiculoLogistico[]

}

model Cosecha {
  id                 String    @id @default(uuid())
  titulo             String    @default("Producto Agropecuario")
  sector             String    @default("agricola") // agricola, ganadero, acuicola
  categoria          String?
  variedad           String?
  producto           String
  precio             Float
  unidad             String    @default("kg") // kg, cabezas, arrobas, litros
  cantidadDisponible Int       @default(0)
  
  departamento       String?
  municipio          String?
  vereda             String?
  ubicacion          String    @default("Colombia")
  latitud            Float?
  longitud           Float?
  
  fechaRecoleccion   DateTime? 
  fechaCosechaStr    String?
  tiempoTransporte   String?
  
  descripcion        String?
  imagenes           String?
  certificaciones    String?
  
  estado             String    @default("disponible")
  origen             String    @default("O") // O = Original, D = Demo
  
  productorId        String
  productor          Usuario   @relation(fields: [productorId], references: [id])
  contratos          Contrato[]
  consultas          CosechaConsulta[]
}

model CosechaConsulta {
  id                String   @id @default(uuid())
  cosechaId         String
  cosecha           Cosecha  @relation(fields: [cosechaId], references: [id], onDelete: Cascade)
  
  compradorNombre   String
  compradorTelefono String
  mensaje           String?
  fechaConsulta     DateTime @default(now())
  estado            String   @default("PENDIENTE") // PENDIENTE, RESPONDIDO
}

model CompradorVerificado {
  id                        String   @id @default(uuid())
  usuarioId                 String   @unique
  usuario                   Usuario  @relation(fields: [usuarioId], references: [id])
  
  tipoDocumento             String   // CC, NIT
  numeroDocumento           String   @unique
  rutDigital                String?  // URL
  certificadoCamaraComercio String?  // URL
  estadoSarlaft             Boolean  @default(false)
  firmaDigital              String?  // Hash o URL
}

model VehiculoLogistico {
  id                         String   @id @default(uuid())
  transportistaId            String
  transportista              PerfilTransportista @relation(fields: [transportistaId], references: [id])
  
  resolucionMinTransporte    String?
  placaVehiculo              String   @unique
  tipoVehiculo               String
  vencimientoSOAT            DateTime?
  vencimientoTecnicomecanica DateTime?
  polizaSeguroCarga          String?
  
  contratos                  Contrato[]
}

model Contrato {
  id                    String   @id @default(uuid())
  fechaCreacion         DateTime @default(now())
  
  cosechaId             String
  cosecha               Cosecha  @relation(fields: [cosechaId], references: [id])
  
  productorId           String
  productor             Usuario  @relation("ProductorContrato", fields: [productorId], references: [id])
  
  compradorId           String
  comprador             Usuario  @relation("CompradorContrato", fields: [compradorId], references: [id])
  
  vehiculoId            String?
  vehiculo              VehiculoLogistico? @relation(fields: [vehiculoId], references: [id])
  
  volumen               Float
  precioPactado         Float
  lugarEntrega          String
  clausulaSaneamiento   Boolean  @default(true)
  
  estadoContrato        String   @default("PENDIENTE_FIRMAS") // FIRMADO, EN_TRANSITO, ENTREGADO
  manifiestoCarga       String?  
}

// ==========================================
// MÓDULOS DE LA ESCUELA RURAL (ACADEMIA)
// ==========================================

model AcademiaCurso {
  id          String   @id @default(uuid())
  nombre      String   // Ej: "Café", "Aguacate Hass", "Ganado Bovino"
  descripcion String?
  icono       String?  // Ej: "☕", "🥑"
  estado      String   @default("ACTIVO")
  sector      String   @default("agricola") // agricola, ganadero, acuicola
  
  etapas      AcademiaEtapa[]
  diplomas    AcademiaDiploma[]
}

model AcademiaEtapa {
  id          String   @id @default(uuid())
  cursoId     String
  curso       AcademiaCurso @relation(fields: [cursoId], references: [id])
  
  orden       Int      // 1, 2, 3, 4... (Etapa 1: La Cuna)
  titulo      String   // Ej: "Etapa 1: Semillero y Suelo"
  descripcion String?
  
  lecciones   AcademiaLeccion[]
}

model AcademiaLeccion {
  id          String   @id @default(uuid())
  etapaId     String
  etapa       AcademiaEtapa @relation(fields: [etapaId], references: [id])
  
  orden       Int      // 1, 2, 3...
  titulo      String   // Ej: "Cómo preparar abono orgánico"
  tipo        String   // "AUDIO", "VIDEO"
  urlContenido String? // URL del archivo MP3 o Video YouTube
  duracionMinutos Int?
  
  // NUEVO: Adaptación climática
  climaRecomendado String @default("TODOS") // CALIDO, TEMPLADO, FRIO, TODOS
  
  progresos   AcademiaProgreso[]
}

model AcademiaProgreso {
  id          String   @id @default(uuid())
  usuarioId   String
  usuario     Usuario  @relation(fields: [usuarioId], references: [id])
  
  leccionId   String
  leccion     AcademiaLeccion @relation(fields: [leccionId], references: [id])
  
  completado  Boolean  @default(false)
  fechaCompletado DateTime?
  
  @@unique([usuarioId, leccionId])
}

model AcademiaDiploma {
  id                  String   @id @default(uuid())
  usuarioId           String
  usuario             Usuario  @relation(fields: [usuarioId], references: [id])
  
  cursoId           String
  curso             AcademiaCurso @relation(fields: [cursoId], references: [id])
  
  notaFinal           Float    // Ej: 4.5, 5.0
  fechaEmision        DateTime @default(now())
  codigoVerificacion  String   @unique @default(uuid())
  
  @@unique([usuarioId, cursoId])
}

// ==========================================
// MÓDULO B2B: ALMACENES DE INSUMOS
// ==========================================

model AlmacenInsumos {
  id            String   @id @default(uuid())
  nombre        String
  departamento  String
  municipio     String
  direccion     String?
  telefono      String
  whatsapp      String?
  calificacion  Float    @default(4.8)
  marcas        String?  // Ej: "Yara, Monómeros, Bayer, Italcol"
  categoria     String   @default("mixto") // agricola, veterinario, acuicola, mixto
  imagen        String?
  descripcion   String?
  origen        String   @default("O") // O = Original, D = Demo
  createdAt     DateTime @default(now())
}

// ==========================================
// MÓDULO: BOLSA DE EMPLEO AGROPECUARIO
// ==========================================

model OfertaEmpleo {
  id                   String   @id @default(uuid())
  titulo               String
  sector               String   // agricola, ganadero, acuicola, maquinaria, tecnico
  tipoContrato         String   // Jornal, Fijo, Prestación
  ubicacion            String
  departamento         String
  municipio            String
  salario              Float?
  salarioTexto         String?  // Ej: "$1.800.000 + Prestaciones"
  requiereExperiencia  Boolean  @default(false)
  incluyeHospedaje     Boolean  @default(false)
  incluyeAlimentacion  Boolean  @default(false)
  descripcion          String
  requisitos           String?
  empleadorNombre      String
  empleadorTelefono    String
  estado               String   @default("ACTIVA") // ACTIVA, CERRADA
  origen               String   @default("O") // O = Original, D = Demo
  fechaPublicacion     DateTime @default(now())
  
  postulaciones        PostulacionEmpleo[]
}

model PostulacionEmpleo {
  id                 String       @id @default(uuid())
  empleoId           String
  empleo             OfertaEmpleo @relation(fields: [empleoId], references: [id], onDelete: Cascade)
  
  candidatoNombre    String
  candidatoTelefono  String
  cedula             String?
  experienciaAnos    Int          @default(0)
  mensaje            String?
  estado             String       @default("PENDIENTE") // PENDIENTE, CONTACTADO, DESCARTADO
  origen             String       @default("O")
  fechaPostulacion   DateTime     @default(now())
}

// ==========================================
// MÓDULO: INTELIGENCIA DE PRECIOS Y MERCADO
// ==========================================

model PrecioMercado {
  id                  String   @id @default(uuid())
  producto            String
  categoria           String
  variedad            String?
  centralAbastos      String   // Corabastos, Cavasa, Cenabastos, etc.
  departamento        String
  precioMinimo        Float
  precioMaximo        Float
  precioPromedio      Float
  unidad              String   @default("kg") // kg, bulto, arroba
  tendencia           String   @default("estable") // alza, baja, estable
  variacionSemanal    Float    @default(0.0)
  fechaActualizacion  DateTime @default(now())
}

// ==========================================
// MÓDULO: DIRECTORIO DE AGREMIACIONES Y ONGS
// ==========================================

model Agremiacion {
  id                String   @id @default(uuid())
  nombre            String
  sigla             String
  sector            String   // cafe, ganado, arroz, cacao, frutas, etc.
  descripcion       String
  logoUrl           String?
  sitioWeb          String?
  telefono          String?
  departamentoSede  String?
  programasApoyo    String?  // JSON string
}

// ==========================================
// MÓDULO: NOTICIAS Y BOLETINES AGRARIOS
// ==========================================

model NoticiaAgraria {
  id                String   @id @default(uuid())
  titulo            String
  resumen           String
  contenido         String
  categoria         String
  fuente            String
  imagenUrl         String?
  fechaPublicacion  DateTime @default(now())
  destacada         Boolean  @default(false)
  origen            String   @default("O") // O = Original, D = Demo
}

// ==========================================
// MÓDULO: ALERTAS FITOSANITARIAS Y CLIMÁTICAS
// ==========================================

model AlertaMercado {
  id                String   @id @default(uuid())
  tipo              String   // clima, fitosanitaria, precio, oportunidad
  nivel             String   @default("info") // info, advertencia, critica
  titulo            String
  mensaje           String
  departamento      String?
  sector            String?
  fechaEmision      DateTime @default(now())
  activa            Boolean  @default(true)
}

// ==========================================
// MÓDULO: CALENDARIO DE TEMPORADAS DE COSECHA
// ==========================================

model TemporadaCosecha {
  id                String   @id @default(uuid())
  cultivo           String
  departamento      String
  mesesPico         String   // Ej: "Marzo - Mayo, Octubre - Diciembre"
  intensidad        String   @default("Alta") // Alta, Media, Baja
  observaciones     String?
}

